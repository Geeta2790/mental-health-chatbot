# Copy to .env.docker and fill in real values.
# .env.docker is gitignored by this project.

# OpenAI
OPENAI_API_KEY=sk-replace-me

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Postgres (used by both the postgres container and the app DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wellmind

# Set to 1 for local/dev convenience: /auth/send-otp returns the OTP so the UI
# can auto-fill it. NEVER enable this in production.
DEV_MODE=1

# Public domain for the Caddy reverse proxy (production profile only).
# Example: DOMAIN=wellmind.duckdns.org
# Leave empty for local dev - Caddy only starts with the production profile.
DOMAIN=
